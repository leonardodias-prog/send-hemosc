*.db
*.sqlite
*.sqlite3
/data/real/
*.csv
*.xlsx
!docs/**/*.xlsx

# Build / compilação
*.class
*.jar
*.war
__pycache__/
*.py[cod]
.venv/
venv/

# Logs
*.log
logs/
npm-debug.log*

# IDE
.idea/
.vscode/
*.iml
*.swp

# Sistema operacional
Thumbs.db
desktop.ini
.DS_Store

# Temporários do Office (arquivos de bloqueio ao abrir .docx)
~$*

# Configuracao local de ferramentas de desenvolvimento
/.claude/
