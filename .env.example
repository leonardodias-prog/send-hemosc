# Variaveis de ambiente do Send Hemosc.
#
# Copie para .env e preencha. O arquivo .env e ignorado pelo git de proposito:
# NUNCA versione credencial. No Render, os valores vao pela aba Environment.

# --- Perfil ---
# dev = H2 em memoria, seed ficticio, console H2 liberado
# demo = igual ao dev porem sem console e sem agendador automatico (usado no deploy)
# postgres = exige banco no ar
SPRING_PROFILES_ACTIVE=demo

# Endereco publico, usado no link de descadastro dos e-mails
APP_URL_BASE=http://localhost:8080

# --- Envio de e-mail ---
# log    = nao envia nada, apenas registra no console (padrao)
# smtp   = envia pelo servidor SMTP. Funciona local; bloqueado em hospedagem gratuita.
# resend = envia pela API HTTP do Resend, na porta 443. Use este no Render.
EMAIL_MODO=log

# Redireciona TODA mensagem para os enderecos abaixo, seja qual for o doador.
# Aceita varios separados por virgula, para a equipe acompanhar o mesmo teste.
# No perfil demo e OBRIGATORIO quando EMAIL_MODO=smtp: sem ele a aplicacao recusa subir,
# porque a demonstracao e publica e dispararia para a massa ficticia inteira.
EMAIL_DESTINATARIO_TESTE=

# --- Opcao 1: Resend (API HTTP) ---
# Chave em https://resend.com/api-keys. Sem dominio verificado o Resend so aceita o remetente
# onboarding@resend.dev e so entrega para o e-mail dono da conta.
RESEND_API_KEY=

# --- Opcao 2: SMTP ---
# Para Gmail use uma senha de app, nunca a senha da conta:
# https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# No Gmail o remetente precisa ser a propria conta autenticada
MAIL_REMETENTE=
