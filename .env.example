# Variaveis de ambiente do Send Hemosc.
#
# Copie para .env e preencha. O .env e ignorado pelo git de proposito: NUNCA versione
# credencial. No Render, os valores vao pela aba Environment.

# --- Perfil ---
# dev      = H2 em memoria, massa ficticia, console H2 liberado
# producao = PostgreSQL, sem massa ficticia (usado no deploy)
SPRING_PROFILES_ACTIVE=dev

# Endereco publico. Monta os links de descadastro e de aprovacao enviados por e-mail.
APP_URL_BASE=http://localhost:8080

# --- Banco de dados (apenas no perfil producao) ---
# String de conexao do Neon em formato JDBC:
# jdbc:postgresql://ep-nome-123.sa-east-1.aws.neon.tech/sendhemosc?sslmode=require
DB_URL=
DB_USER=
DB_PASSWORD=

# --- Administrador inicial ---
# Criado somente na primeira subida, quando ainda nao existe nenhum administrador.
# Sem MASTER_SENHA, uma senha aleatoria e gerada e escrita no log da subida.
MASTER_EMAIL=admin@sendhemosc.local
MASTER_NOME=Administrador
MASTER_SENHA=

# --- Envio de e-mail ---
# log   = nao envia nada, apenas registra no console (padrao)
# brevo = entrega pela API HTTP do Brevo, na porta 443
EMAIL_MODO=log

# Chave em https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Remetente verificado no Brevo. Sem dominio proprio, verifica-se um endereco avulso.
MAIL_REMETENTE=

# Quando preenchido, TODA mensagem vai para estes enderecos, seja qual for o doador.
# Aceita varios separados por virgula. Deixe vazio para que cada pessoa receba no proprio
# endereco, que e o comportamento real do sistema.
EMAIL_DESTINATARIO_TESTE=

# --- Opcionais ---
# Varredura automatica do estoque. O valor "-" desliga.
CRON_CONVOCACAO=-
# Massa ficticia no perfil producao. Ligar uma vez basta.
SEED_HABILITADO=false
